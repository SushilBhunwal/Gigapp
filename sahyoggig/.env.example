# SahyogGig — Environment Variables
# Copy this file to .env and fill in your values.

# ─── Database ────────────────────────────────────────────────────────────────
# Supabase direct connection (used by Prisma for migrations + dev)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?connection_limit=1&pool_timeout=20

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-at-least-32-chars

# LOCAL:      http://localhost:3000
# PRODUCTION: https://your-app.vercel.app   ← MUST change this after deploy!
NEXTAUTH_URL=http://localhost:3000

# ─── Supabase (Public — safe to expose to the browser) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
